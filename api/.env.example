# Configurações do Servidor da API
PORT=3000
HOST=http://localhost:3000

# Caminho absoluto no computador local onde se encontra a pasta contendo "Cartas Monstro", "Cartas Magia", etc.
# Exemplo Windows: D:\Imagens\Yu-Gi-Oh-HD
# Exemplo Linux/macOS: /home/usuario/Imagens/Yu-Gi-Oh-HD
IMAGES_BASE_DIR=C:\caminho\para\sua\pasta\Yu-Gi-Oh-HD
